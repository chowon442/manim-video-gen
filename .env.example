# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
# 일시적 오류 시 재시도(HTTP 429/5xx, 프로바이더 524 등)
MANIM_VIDEO_GEN_OPENROUTER_RETRIES=2
MANIM_VIDEO_GEN_OPENROUTER_RETRY_BASE_SECONDS=1.5
MANIM_VIDEO_GEN_OPENROUTER_RETRY_MAX_SECONDS=15

# JSON 파싱·스키마 검증 실패 시, 추가 완료 호출을 최대 몇 번까지 할지(각각 새 OpenRouter 요청). 기본 3 = 최초 1회 + 재시도 2회.
MANIM_VIDEO_GEN_LLM_JSON_PARSE_MAX_ATTEMPTS=3

# ElevenLabs (https://elevenlabs.io)
ELEVENLABS_API_KEY=
# Voice ID — 한국어 품질을 위해 반드시 설정 권장
#
# 무료 플랜: ElevenLabs 대시보드 Voice Lab에서 직접 만든 보이스의 ID만 API로 사용 가능
# (라이브러리 프리셋 음성은 무료 플랜에서 API 호출 불가 → 402 오류)
#
# 한국어 지원 multilingual_v2 음성 예시 (Voice Library에서 확인):
#   Aria (기본값)  : 9BWtsMINqrJLrRacOk9x
#   Charlotte      : XB0fDUnXU5powFXDhCwa
#   Sarah          : EXAVITQu4vr4xnSDxMaL
#
# 최상의 한국어 품질: https://elevenlabs.io/voice-library 에서
# "Korean" 필터로 전용 한국어 음성을 검색하여 ID를 복사하세요.
ELEVENLABS_VOICE_ID=
# 먼저 /with-timestamps 시도(402/403 시 표준 TTS로 폴백). false면 타임스탬프 API 생략.
MANIM_VIDEO_GEN_ELEVENLABS_TRY_TIMESTAMPS=true

# LLM 모델(OpenRouter 슬러그)
MANIM_VIDEO_GEN_MODEL_SOLVE=openai/gpt-4o
MANIM_VIDEO_GEN_MODEL_SCRIPT=openai/gpt-4o
MANIM_VIDEO_GEN_MODEL_MANIM=openai/gpt-4o

# Manim 렌더 품질: l, m, h, p, k
MANIM_VIDEO_GEN_MANIM_QUALITY_LOW=l
MANIM_VIDEO_GEN_MANIM_QUALITY_HIGH=h

# FFmpeg: 세그먼트 간 크로스페이드(초). 0이면 단순 이어붙이기.
MANIM_VIDEO_GEN_CROSSFADE_DURATION=0.20

# 다음 씬 전까지 이전 씬 마지막 화면을 유지할 시간(초). 0이면 비활성.
# 0보다 크면 마지막 프레임 동결+무음 패딩 후 이어붙이며, 이때 위 크로스페이드는 적용되지 않음.
MANIM_VIDEO_GEN_INTER_SCENE_GAP_SECONDS=0

# 인접 씬/체인 사이 의미 브릿지 전환(true/false). 매핑 신뢰도가 낮으면 일반 하드 컷으로 폴백.
MANIM_VIDEO_GEN_SCENE_BRIDGE_ENABLED=false

# TTS: elevenlabs | azure | replicate | inworld | grok | xai
MANIM_VIDEO_GEN_TTS_PROVIDER=elevenlabs
# Azure Speech (MANIM_VIDEO_GEN_TTS_PROVIDER=azure 일 때)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
MANIM_VIDEO_GEN_AZURE_TTS_VOICE=ko-KR-SunHiNeural

# Replicate qwen/qwen3-tts (MANIM_VIDEO_GEN_TTS_PROVIDER=replicate 일 때)
# https://replicate.com/qwen/qwen3-tts
REPLICATE_API_TOKEN=
# custom_voice | voice_clone | voice_design
MANIM_VIDEO_GEN_REPLICATE_TTS_MODE=custom_voice
MANIM_VIDEO_GEN_REPLICATE_TTS_SPEAKER=Aiden
MANIM_VIDEO_GEN_REPLICATE_TTS_LANGUAGE=auto
# voice_design: 자연어 음성 설명
MANIM_VIDEO_GEN_REPLICATE_TTS_VOICE_DESC=
# voice_clone: 참조 오디오 URL + 선택적 대본
MANIM_VIDEO_GEN_REPLICATE_TTS_REF_AUDIO=
MANIM_VIDEO_GEN_REPLICATE_TTS_REF_TEXT=
# 선택 스타일(예: 천천히 차분하게)
MANIM_VIDEO_GEN_REPLICATE_TTS_STYLE=

# xAI Grok TTS (MANIM_VIDEO_GEN_TTS_PROVIDER=grok 또는 xai)
# https://docs.x.ai/developers/model-capabilities/audio/text-to-speech
XAI_API_KEY=
# MANIM_VIDEO_GEN_XAI_API_KEY=
# 음성: Eve | Ara | Leo | Rex | Sal (API voice_id)
MANIM_VIDEO_GEN_XAI_TTS_VOICE=Ara
# BCP-47 (예: ko, en) 또는 auto
MANIM_VIDEO_GEN_XAI_TTS_LANGUAGE=ko

# 세그먼트 합성 시 ASS 자막 입힘(true/false)
MANIM_VIDEO_GEN_BURN_SUBTITLES=true

# 자막(ASS) 튜닝
# - auto: 수동 \N 없음, libass가 폭/마진 기준 자동 줄바꿈(권장)
# - char: MANIM_VIDEO_GEN_SUBTITLE_MAX_CHARS 기준으로 수동 \N 삽입
MANIM_VIDEO_GEN_SUBTITLE_MAX_CHARS=56
MANIM_VIDEO_GEN_SUBTITLE_WRAP_MODE=auto
# 자막 글꼴·여백(픽셀)
MANIM_VIDEO_GEN_SUBTITLE_FONT_SIZE=42
MANIM_VIDEO_GEN_SUBTITLE_MARGIN_L=56
MANIM_VIDEO_GEN_SUBTITLE_MARGIN_R=56
MANIM_VIDEO_GEN_SUBTITLE_MARGIN_V=44

# 자막과 겹치지 않도록 하단 안전 영역 확보(픽셀, 0=끔)
# 예: 160 → 하단 160px을 자막용으로 두고, 그 위로 영상을 축소·패딩.
MANIM_VIDEO_GEN_SUBTITLE_SAFE_AREA_PX=0

# 내레이션·시각 일관성 검사: off | warn | error
# - off: 검사 안 함
# - warn: 이슈만 로그하고 계속
# - error: error 수준 이슈에서 실행 중단
MANIM_VIDEO_GEN_CONSISTENCY_MODE=warn

# consistency_mode=error일 때 자동 보정 루프
# - true: error 수준 이슈 발견 시 scriptify에 JSON 수정 요청 후 재검증
# - false: error 수준 이슈에서 즉시 실패
MANIM_VIDEO_GEN_CONSISTENCY_AUTO_REPAIR=true
# 추가 보정 시도 횟수 상한(정수, 0 이상)
MANIM_VIDEO_GEN_CONSISTENCY_AUTO_REPAIR_MAX_ATTEMPTS=2

# 대본 품질 가드(설명 품질 우선 + 최소수정 보정)
# - false(기본): 기존 동작 유지
# - true: scriptify 결과를 품질 점수화하고, 필요 시 제한된 segment만 재작성
MANIM_VIDEO_GEN_SCRIPT_QUALITY_ENABLED=false
# quality_first | balanced | stable
MANIM_VIDEO_GEN_SCRIPT_QUALITY_PROFILE=quality_first
# 허용 최소 품질 점수(0~1)
MANIM_VIDEO_GEN_SCRIPT_QUALITY_MIN_TOTAL=0.82
# 품질 보정 재시도 횟수
MANIM_VIDEO_GEN_SCRIPT_QUALITY_MAX_ATTEMPTS=2
# 한 번의 보정에서 수정 허용되는 세그먼트 수 상한
MANIM_VIDEO_GEN_SCRIPT_QUALITY_MAX_SEGMENTS_PER_ATTEMPT=2
# true면 소프트 이슈가 남아도 실패(fail-fast), false면 best-effort 진행
MANIM_VIDEO_GEN_SCRIPT_QUALITY_FAIL_ON_SOFT_AFTER_MAX=false

# 진단
# 실행 산출물(대본/세그먼트/생성 씬 코드/ASS/타이밍)을 artifacts/runs/<run_id>/ 에 저장
MANIM_VIDEO_GEN_DIAGNOSTIC_DUMP=false
# 실행 후 .tmp/manim_video_* 작업 폴더 유지(디버깅용)
MANIM_VIDEO_GEN_KEEP_WORKSPACE=false

# 선택 해상도·FPS(0이면 Manim 기본값)
MANIM_VIDEO_GEN_VIDEO_WIDTH=0
MANIM_VIDEO_GEN_VIDEO_HEIGHT=0
MANIM_VIDEO_GEN_VIDEO_FPS=0

# 선택 배경음 경로(절대/상대), 내레이션 아래로 믹스
MANIM_VIDEO_GEN_BGM_PATH=
MANIM_VIDEO_GEN_BGM_VOLUME=0.2

# 한국어 렌더링 CJK 폰트 (xelatex + xeCJK)
# Windows 기본값: Malgun Gothic / macOS 기본값: AppleGothic / Linux 기본값: Noto Sans CJK KR
# 기본값(OS 자동 감지)을 변경하려면 아래 주석을 해제하고 폰트명을 입력하세요.
# MANIM_VIDEO_GEN_CJK_FONT=Malgun Gothic
